# Mahsulot katalogi — sayt API'si (kalitsiz), xotirada saqlanadi va har
# PRODUCTS_REFRESH_SECONDS'da qayta yuklanadi (app/catalog.py)
PRODUCTS_API_URL=https://demo.dunyabunya.uz/auth-api/api/products
PRODUCTS_REFRESH_SECONDS=300
# Mijozga beriladigan havola: {SITE_BASE_URL}/{uz|ru}/catalog/{id}
SITE_BASE_URL=https://demo.dunyabunya.uz

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=20
MAX_RESPONSE_TOKENS=500

# System promptdagi {KOMPANIYA_NOMI}/{TELEFON}/{MANZIL}/{ISH_VAQTI}/{OPERATOR_TELEGRAM} o'rnini bosadi
COMPANY_NAME=dunyabunya
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_WORK_HOURS=
OPERATOR_TELEGRAM=

# Operator-relay (app/telegram_operator.py): mijoz so'rovi shu bot orqali
# operatorga yuboriladi, operator "Reply" qilganda javob avtomatik veb-
# suhbatga qaytadi. CHAT_ID getUpdates orqali /start xabaridan olinadi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
OPERATOR_TELEGRAM_CHAT_ID=

# Modelga yuboriladigan oxirgi N ta xabar
HISTORY_MAX_MESSAGES=10

# Suiiste'moldan himoya (/api/chatbot/ask, conversation_id bo'yicha)
RATE_LIMIT_PER_MINUTE=10
SESSION_MESSAGE_LIMIT=50

# Frontend uchun ruxsat etilgan originlar (vergul bilan). "*" — hamma uchun ochiq.
CORS_ORIGINS=*
