# dunyabunya CEO agent — sozlamalar namunasi.
#
#   copy .env.example .env      — keyin qiymatlarni to'ldiring. .env faylini git'ga qo'shmang.
#
# MUHIM: izohni qiymat bilan bir qatorga yozmang ("KALIT=   # izoh" — izoh qiymat bo'lib o'qiladi).
# O'zgartirgandan keyin botni qayta ishga tushiring: scripts\restart_bot.ps1

# ── Telegram ────────────────────────────────────────────────────────────────
# @BotFather bergan token
TELEGRAM_BOT_TOKEN=
# Asosiy (mavzularga bo'lingan) guruh ID'si, masalan -1001234567890
TELEGRAM_GROUP_ID=
# CEO username'lari, "@"siz, vergul bilan: birinchi_ceo,ikkinchi_ceo
CEO_TELEGRAM_USERNAME=
# Ixtiyoriy: CEO'ning raqamli Telegram ID'si (username o'rniga)
CEO_TELEGRAM_USER_ID=0

# ── Odoo ────────────────────────────────────────────────────────────────────
# Manzil o'zgarsa: README -> "Odoo bazasini almashtirish" (python scripts/check_topics.py --fix)
# *.dev.odoo.com — Odoo.sh SINOV bazasi: manzili o'zgarib turadi, ma'lumoti o'chadi. Productionga yaramaydi.
ODOO_URL=
ODOO_DB=
# Odoo login (email)
ODOO_USERNAME=
# Odoo: Preferences -> Account Security -> New API Key
ODOO_API_KEY=
ODOO_TIMEOUT_SECONDS=30
# Odoo'ga bir vaqtda yuboriladigan so'rovlar chegarasi (ortiqchasi navbatda kutadi)
ODOO_MAX_CONCURRENCY=4

# ── Ma'lumotlar bazasi (PostgreSQL) ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/dunyabunya_agent_db
# Menejerlarning Odoo API kalitlarini shifrlash uchun. Yaratish:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Yo'qotilsa — saqlangan kalitlarni ochib bo'lmaydi (menejerlar qaytadan ulanadi).
ENCRYPTION_KEY=

# ── AI ──────────────────────────────────────────────────────────────────────
# Claude — asosiy yordamchi (savol-javob, tahlil, hisobotlar, amallar)
ANTHROPIC_API_KEY=
# Kalit workspace'ga bog'lanmagan bo'lsa — workspace ID (aks holda bo'sh)
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5
# Yordamchi qanchalik chuqur o'ylashi: low | medium | high | xhigh | max (yuqoriroq = sekinroq va qimmatroq)
ANTHROPIC_EFFORT=medium
# Yordamchi internetdan qidira olishi (valyuta kursi, yangilik). Har bir qidiruv uchun Anthropic alohida haq oladi
WEB_SEARCH_ENABLED=true
# Bitta savolga yordamchi eng ko'pi bilan nechta qadam qilishi mumkin
AGENT_MAX_STEPS=14
# OpenAI — guruhdagi xabarni saralash (vazifami-yo'qmi), ovozni matnga o'girish, ovozli xabar
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_WHISPER_MODEL=gpt-4o-transcribe

# ── Ilova ───────────────────────────────────────────────────────────────────
# 127.0.0.1 — faqat shu server; 0.0.0.0 — tarmoqdan ham ochiq (/health, /reports)
APP_HOST=0.0.0.0
APP_PORT=8002
LOG_LEVEL=INFO
STORAGE_DIR=./storage
# Hisobot fayllari manzili (hisobotlar Telegram orqali fayl bo'lib yuboriladi)
PUBLIC_BASE_URL=http://localhost:8002

# ── Monitoring va rejalashtirilgan ishlar ───────────────────────────────────
# Tizim xatolari yuboriladigan chat (botga /id yozib bilib oling). 0 = o'chiq
ALERT_CHAT_ID=0
# CEO'larga kunlik xulosa vaqti (Toshkent), masalan 08:30. Bo'sh = yuborilmaydi
DAILY_BRIEFING_TIME=
# Kunlik zaxira nusxalar papkasi (scripts/backup_db.ps1 yozadigan joy bilan bir xil bo'lsin)
BACKUP_DIR=E:\Backups\dunyabunya_db
# Suhbat tarixi necha kundan keyin o'chiriladi. 0 = o'chirilmaydi
CONVERSATION_RETENTION_DAYS=0
# Hisobot fayllari diskda necha soat saqlanadi
REPORT_LINK_TTL_HOURS=48
# Muddatsiz vazifa necha kundan keyin CEO'ga eslatiladi
TASK_REMINDER_STALE_DAYS=3

# ── Guruhdagi xabarlarni saralash ───────────────────────────────────────────
OTHER_GROUP_MIN_DEPARTMENT_SCORE=0.3
OTHER_GROUP_MIN_TASK_CONFIDENCE=0.70
