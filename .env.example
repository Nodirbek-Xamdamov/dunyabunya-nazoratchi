# Kamera ulanishi. Bu qiymatlar faqat shu faylda turadi: hech qayerga yuborilmaydi,
# git'ga tushmaydi, logda va ekranda rtsp://***:***@IP ko'rinishida chiqadi.
# Notepad'da to'ldirib saqlang (Ctrl+S). Qo'shtirnoq kerak emas.
#
# VLC'dagi manzilingiz taxminan shunday ko'rinadi:
#   rtsp://LOGIN:PAROL@IP:554/Streaming/Channels/101
# Undagi qismlarni pastga alohida yozing.

# Kameraning IP manzili, masalan 192.168.1.64
CAMERA_IP=
# RTSP porti (VLC manzilida IP dan keyingi ":" dan keyin turadi, odatda 554)
CAMERA_PORT=554
# Kamera logini (ko'pincha admin)
CAMERA_USER=
# Kamera paroli. Maxsus belgilar (@ # % / va h.k.) bo'lsa ham parolning o'zini yozing.
CAMERA_PASSWORD=

# Yoki: yuqoridagi 4 qator o'rniga VLC'dagi to'liq manzilni shu yerga qo'yishingiz mumkin.
# Bu faqat CAMERA_IP bo'sh bo'lganda ishlatiladi.
CAMERA_RTSP_URL=
