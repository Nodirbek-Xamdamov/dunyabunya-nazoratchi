# Dashboard sozlamalari. Nusxa oling: dashboard\.env (botning asosiy .env fayli ishlatilmaydi va o'qilmaydi).
# Nisbiy yo'llar dashboard papkasiga nisbatan.

# --- Ma'lumot manbalari (faqat o'qish) ---
DB_PATH=../data/monitor.db
REPORTS_DIR=../reports
BACKUP_DIR=../backups
# bot saqlagan rasm/GIF'lar (kompaniyaga oid suhbatlardan), guruh lentasida ko'rsatiladi
MEDIA_DIR=../data/media

# --- Demo rejim (1 = demo\demo_monitor.db dan o'qiydi) ---
DEMO_MODE=0
DEMO_DB_PATH=demo/demo_monitor.db

# --- Vaqt ---
TIMEZONE=Asia/Tashkent
# Botning REPORT_TIME qiymati bilan bir xil bo'lsin (2026-10-19 dan ikkalasida 00:00) --
# "Oxirgi hisobot oynasi" davri va "Hisobot bilan moslik" shu bo'yicha hisoblanadi.
REPORT_TIME=00:00
# Botning SLA_MINUTES qiymati
SLA_MINUTES=5
# Faqat dashboard ichidagi "ish vaqti" ko'rinishi uchun (botga ta'sir qilmaydi)
WORK_HOURS=09:00-19:00

# --- Kirish va manzil ---
# Bo'sh parol faqat 127.0.0.1 uchun ruxsat etiladi. Boshqa manzilda parol majburiy.
DASHBOARD_PASSWORD=
DASHBOARD_HOST=127.0.0.1
# 8501 bu serverda boshqa Streamlit ilovasi bilan band
DASHBOARD_PORT=8502

# --- AI yordamchi (o'ng pastdagi tugma) ---
# Provayder: openai (hozir) yoki anthropic (Claude). Kalitsiz chat o'chiq turadi; kalitlar faqat shu faylda.
CHAT_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Anthropic kaliti workspace'ga bog'langan bo'lsa (CEO agentdagi kabi) -- workspace id
ANTHROPIC_WORKSPACE_ID=
CHAT_ENABLED=1
# bo'sh = provayder standarti: openai -> gpt-5.4-mini, anthropic -> claude-opus-5-5
CHAT_MODEL=
# low | medium | high -- noto'g'ri tushunsa medium qiling (sekinroq, qimmatroq)
CHAT_EFFORT=low
# faqat anthropic: Claude so'rovni rad etsa, javobni zaxira model beradi
CHAT_FALLBACKS=1
# bitta agentning ko'pi bilan nechta qadam qilishi
CHAT_MAX_STEPS=6
# modelga yuboriladigan oldingi xabarlar soni
CHAT_CONTEXT_MESSAGES=20
# kuniga ko'pi bilan nechta xabar (0 = cheksiz)
CHAT_DAILY_LIMIT=200
# Ko'rinish o'zgarishlari va chat tarixi (dashboard'ning o'z fayli; bot bazasi emas)
STATE_DB_PATH=data/state.db

# --- «AI agentlar» sahifasida yaratiladigan agentlar ---
# Vazifani tahlil qilib agentni taklif qiladigan model (bo'sh = gpt-5.4 / claude-opus-5-5)
AGENT_BUILDER_MODEL=
# ko'pi bilan nechta agent yaratish mumkin
AGENT_MAX=20
# agentlar Odoo'dan o'qiy oladigan modellar (faqat o'qish; Odoo foydalanuvchisining huquqlari ham cheklaydi)
AGENT_ODOO_MODELS=res.partner,sale.order,sale.order.line,account.move,crm.lead,product.product,product.template,stock.quant,purchase.order,project.task,res.users
# har bir agent botiga kuniga ko'pi bilan nechta savol; bot eslab qoladigan oxirgi xabarlar soni
AGENT_BOT_DAILY_LIMIT=200
AGENT_BOT_HISTORY=12
# bu botlarning tokenini agentga ulab bo'lmaydi (ishlab turgan botlar)
PROTECTED_BOT_USERNAMES=dunyabunya_assistant_bot,db_hisobchi_bot,david_prototype_bot

# --- Kesh va cheklovlar ---
CACHE_TTL_OPEN=60
CACHE_TTL_CLOSED=600
QUERY_TIMEOUT_SECONDS=10
RESULT_LIMIT=1000
FEED_LIMIT=300

# --- Ma'lumot yangiligi va jim guruhlar ---
FRESHNESS_YELLOW_MINUTES=120
FRESHNESS_RED_MINUTES=720
PENDING_STALE_MINUTES=30
SILENT_DAYS=7

# --- Xavf bali (0-100): vaznlar va chegaralar ---
RISK_W_MISSED=0.35
RISK_W_RATE=0.25
RISK_W_GROWTH=0.20
RISK_W_SLOW=0.20
# shuncha javobsiz so'rov = to'liq ball
RISK_CAP_MISSED=5
# shikoyat darajasi shunga yetsa = to'liq ball (0.4 = 40%)
RISK_CAP_RATE=0.4
# shikoyatlar o'sishi (1.0 = +100%)
RISK_CAP_GROWTH=1.0
# median javob SLA dan shuncha daqiqa oshsa = to'liq ball
RISK_CAP_SLOW_MINUTES=30
# kompaniyaga oid xabarlar shundan kam bo'lsa shikoyat darajasi hisobga olinmaydi
RISK_MIN_RELATED=3
RISK_RED=70
RISK_YELLOW=40
