# ============================
# DATABASE
# ============================
# SQLite (default, tez sinov uchun):
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PostgreSQL uchun (production tavsiya etiladi):
# DATABASE_URL=postgresql+asyncpg://db_user:db_password@localhost:5432/odoo_telegram_db

# ============================
# FASTAPI XAVFSIZLIGI
# ============================
API_KEY=CHANGE_ME_SUPER_SECRET_KEY

# ============================
# AIOGRAM BOT
# ============================
BOT_TOKEN=123456789:AAExampleTokenFromBotFather
BOT_USERNAME=@SizningBotUsername

# ============================
# TELETHON USERBOT (my.telegram.org dan olinadi)
# ============================
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
TELETHON_SESSION_NAME=userbot_session

# ============================
# FAYL SAQLASH JOYLARI
# ============================
PDF_STORAGE_DIR=./data/pdfs
WEBHOOK_LOG_DIR=./data/webhook_logs

# ============================
# BIZNES MANTIQ SOZLAMALARI
# ============================
ORDER_EXPIRATION_HOURS=48
USERBOT_POLL_INTERVAL_SECONDS=15
EXPIRATION_CHECK_INTERVAL_SECONDS=3600

# ============================
# SUPPORT & CALL-CENTER
# ============================
# Mijoz xabarlari uzatiladigan premium support akkaunt (username, "@"siz)
SUPPORT_USERNAME=dunyabunya_support
# "Buyurtma berish" tugmasi orqali kelgan so'rovlar yuboriladigan guruh
# (bot shu guruhda admin bo'lishi shart)
CALL_CENTER_GROUP_CHAT_ID=-1004402855904

# ============================
# MIJOZ GURUHLARI MONITORINGI (README 4.5-band)
# ============================
MONITOR_ENABLED=true
# Monitoring bazasi (SQLite fayli)
DB_PATH=./data/monitor.db
# "Kun" chegarasi va 00:00 dagi hisobot shu vaqt mintaqasi bo'yicha
TIMEZONE=Asia/Tashkent
# Kuzatilmaydigan guruhlar (vergul bilan), masalan call-center guruhi
GROUP_MONITOR_EXCLUDED_GROUP_IDS=

# --- Tasniflash va xulosa modeli ---
# ollama -- shu kompyuterdagi lokal model (kalit kerak emas); openai -- OPENAI_API_KEY bilan
GROUP_AI_PROVIDER=ollama
GROUP_AI_MODEL=gemma4:12b
OLLAMA_URL=http://127.0.0.1:11434
GROUP_AI_KEEP_ALIVE=30m
OPENAI_API_KEY=
# Bitta so'rovda bir guruhning nechta xabari tasniflanadi / nechta oldingi xabar kontekst bo'ladi
CLASSIFY_BATCH_SIZE=10
CLASSIFY_CONTEXT_MESSAGES=8

# --- Ovozli xabar / audio / video (ovozi) -> matn, OpenAI orqali (OPENAI_API_KEY kerak) ---
GROUP_STT_ENABLED=true
# O'zbekcha uchun gpt-4o-transcribe (whisper-1 o'zbekchani tanimaydi)
OPENAI_STT_MODEL=gpt-4o-transcribe

# --- 5 daqiqa qoidasi ---
# Guruh admini unvonida (custom title) shu so'zlardan biri bo'lsa u shu guruhning menejeri
MANAGER_TITLES=meneger,menejer,manager,menedj,менедж,менеж
# Shuncha daqiqa ichida javob yozilmasa so'rov "javobsiz" hisoblanadi
SLA_MINUTES=5
# false -- mijozga kimdir javob bersa yetarli (xodim, reply yoki boshqa odamning javobi);
# true -- faqat menejer javobi hisoblanadi (guruhda menejer bo'lmasa -- istalgan xodimniki)
SLA_REQUIRE_MANAGER=false
# Ismi/username'ida shu so'z bor akkaunt xodim hisoblanadi (admin bo'lmasa ham), vergul bilan
STAFF_NAME_KEYWORDS=dunyabunya
# Ish vaqti, masalan 09:00-19:00 (undan tashqaridagi so'rovlar tekshirilmaydi); bo'sh = 24/7
SLA_WORK_HOURS=

# --- Kunlik Excel hisobot ---
# Hisobot guruhi; forum-guruh bo'lsa fayl "General" topigiga tushadi
REPORT_CHAT_ID=
# Har kuni shu vaqtda yuboriladi va undan oldingi 24 soatni qamraydi (00:00 = o'tgan kalendar kuni)
REPORT_TIME=00:00
# Boshqa topikka yuborish kerak bo'lsa o'sha topik ID'si (bo'sh qoldiring = General)
# REPORT_THREAD_ID=
REPORTS_DIR=./reports
# Hisobotni yuborib bo'lmasa xabar beriladigan chat (bo'sh = ODOO_ALERT_CHAT_ID)
# ADMIN_CHAT_ID=
# /test_report buyrug'ini ishlata oladiganlar (vergul bilan Telegram ID'lar)
ADMIN_USER_IDS=
# Bazaning kunlik zaxira nusxalari (monitor_YYYY-MM-DD.db), oxirgi BACKUP_KEEP tasi saqlanadi
BACKUP_DIR=./backups
BACKUP_KEEP=14
