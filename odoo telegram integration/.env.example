# ============================
# DATABASE
# ============================
# SQLite (default, tez sinov uchun):
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PostgreSQL uchun (production tavsiya etiladi):
# DATABASE_URL=postgresql+asyncpg://db_user:db_password@localhost:5432/odoo_telegram_db

# ============================
# FASTAPI XAVFSIZLIGI
# ============================
API_KEY=CHANGE_ME_SUPER_SECRET_KEY

# ============================
# AIOGRAM BOT
# ============================
BOT_TOKEN=123456789:AAExampleTokenFromBotFather
BOT_USERNAME=@SizningBotUsername

# ============================
# TELETHON USERBOT (my.telegram.org dan olinadi)
# ============================
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
TELETHON_SESSION_NAME=userbot_session

# ============================
# FAYL SAQLASH JOYLARI
# ============================
PDF_STORAGE_DIR=./data/pdfs
WEBHOOK_LOG_DIR=./data/webhook_logs

# ============================
# BIZNES MANTIQ SOZLAMALARI
# ============================
ORDER_EXPIRATION_HOURS=48
USERBOT_POLL_INTERVAL_SECONDS=15
EXPIRATION_CHECK_INTERVAL_SECONDS=3600

# ============================
# SUPPORT & CALL-CENTER
# ============================
# Mijoz xabarlari uzatiladigan premium support akkaunt (username, "@"siz)
SUPPORT_USERNAME=dunyabunya_support
# "Buyurtma berish" tugmasi orqali kelgan so'rovlar yuboriladigan guruh
# (bot shu guruhda admin bo'lishi shart)
CALL_CENTER_GROUP_CHAT_ID=-1004402855904

# ============================
# MIJOZ GURUHLARINI KUZATISH (README 4.5-band)
# ============================
# Ichki (xodimlar) forum-guruhi: shikoyat / ijobiy fikr / "tovar yo'q" xabarlari shu yerning
# topiklariga tushadi. Bot shu guruhda admin bo'lishi shart. Bo'sh qolsa kuzatish o'chiq.
# (CENTRAL_FORUM_CHAT_ID deb ham yozish mumkin.)
FEEDBACK_HUB_GROUP_ID=
# Kuzatilmaydigan guruhlar (vergul bilan), masalan call-center guruhi
GROUP_MONITOR_EXCLUDED_GROUP_IDS=
# Toifaga mos topik bo'lmasa bot o'zi yaratadi ("Mavzularni boshqarish" huquqi kerak)
HUB_AUTO_CREATE_TOPICS=true
# Topik ID'larini qo'lda berish: delivery, quality, completeness, staff, price, returns,
# positive, other, stock, unanswered. Masalan: HUB_TOPIC_IDS=delivery=12,price=14
HUB_TOPIC_IDS=

# --- Javobsiz qolgan savol ---
# Xodim shuncha daqiqa javob yozmasa ogohlantirish boradi
STAFF_REPLY_TIMEOUT_MINUTES=5
# dm    -- xodimning shaxsiy chatiga; bot mijoz guruhiga hech narsa yozmaydi
# group -- guruhning o'ziga, shu guruh menejerlarini @username bilan belgilab
GROUP_ALERT_MODE=dm
GROUP_ALERT_TEXT=Mijozning savoli javobsiz qoldi. Iltimos, javob bering.
GROUP_ALERT_REPEAT_MINUTES=60
# Admin unvonida shu bo'laklardan biri bo'lgan xodim guruh menejeri hisoblanadi
GROUP_MANAGER_TITLE_KEYWORDS=menej,meneg,menedj,manag,менедж,менеж

# --- Matn va rasmni tasniflash ---
# ollama -- shu kompyuterdagi lokal Gemma (kalit kerak emas); openai -- OPENAI_API_KEY bilan
GROUP_AI_PROVIDER=ollama
GROUP_AI_MODEL=gemma4:12b
# Lokal model manzili (GEMMA_API_URL deb ham yozish mumkin)
OLLAMA_URL=http://127.0.0.1:11434
GROUP_AI_KEEP_ALIVE=30m
GROUP_AI_MAX_CONCURRENCY=2
# Model xulosasiga shu foizdan kam ishonsa xabar tashlanmaydi
GROUP_AI_MIN_CONFIDENCE=80
# Mijoz yuborgan surat (va video kadrlari) ham tahlil qilinsin
GROUP_IMAGE_ANALYSIS_ENABLED=true
GROUP_IMAGE_MAX_SIDE=1024
GROUP_VIDEO_FRAMES=3
OPENAI_API_KEY=

# --- Ovozli xabar / audio / video ---
GROUP_STT_ENABLED=true
# local -- shu kompyuterda (faster-whisper); openai -- OpenAI transkripsiya API'si
GROUP_STT_PROVIDER=local
# O'zbekcha uchun gpt-4o-transcribe (whisper-1 o'zbekchani tanimaydi -- README'dagi o'lchov)
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_STT_LANGUAGE=
# Ovozli xabar/video matnini tasniflaydigan alohida model: bo'sh = yuqoridagi model; openai = pastdagi
GROUP_MEDIA_AI_PROVIDER=
GROUP_MEDIA_AI_MODEL=gpt-4o-mini
# Lokal nutq modeli: bo'sh = ~/.cache/faster-whisper-ct2/islomov--rubaistt_v2_medium
GROUP_STT_MODEL=
GROUP_STT_RU_MODEL=mobiuslabsgmbh/faster-whisper-large-v3-turbo
GROUP_STT_DEVICE=auto
GROUP_STT_CUDA_DLL_DIR=./cuda_runtime
GROUP_STT_MAX_DURATION_SECONDS=600

# --- Kunlik hisobot (har kuni 00:00 da reports/stats_YYYY-MM-DD.html) ---
DAILY_REPORT_ENABLED=true
DAILY_REPORT_DIR=./reports
REPORT_TIMEZONE=Asia/Tashkent
# Berilsa hisobot fayli shu chatga ham yuboriladi (masalan ichki guruh); forum bo'lsa topik ID'si
# DAILY_REPORT_CHAT_ID=
# DAILY_REPORT_TOPIC_ID=
# message_logs yozuvlari shuncha kundan keyin o'chiriladi (0 = o'chirilmaydi)
MESSAGE_LOG_RETENTION_DAYS=180
