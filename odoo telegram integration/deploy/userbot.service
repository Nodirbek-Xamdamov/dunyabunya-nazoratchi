[Unit]
Description=Telethon Userbot Notifier Service
After=network.target

[Service]
Type=simple
User=appuser
Group=appuser
WorkingDirectory=/opt/odoo_telegram_integration
EnvironmentFile=/opt/odoo_telegram_integration/.env
ExecStart=/opt/odoo_telegram_integration/venv/bin/python -m app.userbot
Restart=always
RestartSec=5
StandardOutput=append:/var/log/odoo_telegram_integration/userbot.log
StandardError=append:/var/log/odoo_telegram_integration/userbot.error.log

[Install]
WantedBy=multi-user.target
