# Nusxa oling: Copy-Item .env.example .env   (keyin qiymatlarni to'ldiring)

# ---- Telegram ----
# BotFather bergan token
TELEGRAM_BOT_TOKEN=
# Bot ishlaydigan guruh ID'lari, vergul bilan (ID bot.log da: "message ... in chat -100..."). Bo'sh = bot qo'shilgan hamma guruh.
# Bo'sh qoldirmang: aks holda botni o'z guruhiga qo'shgan har kim rasm o'qitib, OpenAI hisobingizdan sarflaydi.
ALLOWED_CHAT_IDS=

# ---- Eslatma ----
# To'lov kuni shu soatda eslatiladi
REMIND_AT=09:00
# Reply yozilgan kunning o'ziga ("bugun") qo'yilgan to'lov shu kuni shu soatda eslatiladi
EVENING_AT=18:00
TIMEZONE=Asia/Tashkent

# ---- Rasmni o'qish ----
# Rasmni OpenAI o'qiydi: sana yozilgan har bir rasm OpenAI'ga yuboriladi
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
