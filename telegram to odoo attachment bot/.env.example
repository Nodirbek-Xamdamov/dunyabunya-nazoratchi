# Nusxa oling: Copy-Item .env.example .env   (keyin qiymatlarni to'ldiring)
# .env hech qachon git/chatga tushmasin. REPLACE_ME turgan qiymatlar hali to'ldirilmagan hisoblanadi.

# ---- Telegram ----
BOT_TOKEN=REPLACE_ME
# Bot ishlaydigan guruh chat_id'lari, vergul bilan. Guruh id'lari manfiy: -1001234567890
ALLOWED_CHAT_IDS=
# Adminlarning telegram user_id'lari, vergul bilan (xato xabarlari, /unlink, /users)
ADMIN_IDS=

# ---- Odoo 18 (XML-RPC + API key) ----
ODOO_URL=REPLACE_ME
ODOO_DB=REPLACE_ME
# Yozuvlarni yaratuvchi service user'ning login'i
ODOO_USER=REPLACE_ME
ODOO_API_KEY=REPLACE_ME

# ---- AI (faqat QR o'qilmaganda ishlatiladi) ----
OPENAI_API_KEY=REPLACE_ME

# ---- Ixtiyoriy ----
# Standart: SQLite, <DATA_DIR>/docbot.db. PostgreSQL uchun: postgresql+asyncpg://user:pass@host/db
# DATABASE_URL=
# Standart: loyiha ichidagi data/ (DB, rasmlar, loglar)
# DATA_DIR=
